   "id": "g13",
   "no": 13,
   "week": 2,
   "emoji": "👩‍🏫",
   "title": "have to / don't have to",
   "en": "have to",
   "reuse": null,
   "intro": [
    {
     "h": "一定要",
     "p": "<b>have to</b> + 動詞原形，表示規定或者不得不。<br>he / she 用 <b>has to</b>。",
     "ex": [
      [
       "I have to be quiet.",
       "我一定要安靜。"
      ],
      [
       "She has to wear a uniform.",
       "佢一定要著校服。"
      ]
     ]
    },
    {
     "h": "唔使",
     "p": "<b>don't have to</b> 係「唔使」，唔係「唔准」。<br>唔准用 must not 或者 can't。",
     "ex": [
      [
       "You don't have to run.",
       "你唔使跑。"
      ],
      [
       "We must not shout.",
       "我哋唔准大叫。"
      ]
     ]
    }
   ],
   "exercises": [
    {
     "t": "mc",
     "q": "I ___ line up.",
     "zh": "我一定要排隊。",
     "o": [
      "have to",
      "has to",
      "having to",
      "have"
     ],
     "a": 0,
     "why": "I 用 have to。"
    },
    {
     "t": "mc",
     "q": "He ___ be polite.",
     "zh": "佢一定要有禮。",
     "o": [
      "has to",
      "have to",
      "have",
      "is to"
     ],
     "a": 0,
     "why": "he 用 has to。"
    },
    {
     "t": "mc",
     "q": "You ___ shout. It is a free choice.",
     "zh": "你唔使大叫。",
     "o": [
      "don't have to",
      "must not",
      "has not",
      "aren't"
     ],
     "a": 0,
     "why": "唔使用 don't have to；must not 係唔准。"
    },
    {
     "t": "fill",
     "q": "She has to ___ the homework.",
     "zh": "佢一定要做功課。",
     "a": [
      "do",
