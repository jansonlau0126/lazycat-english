   "title": "agree / suggest / let's",
   "en": "agree, suggest, let's",
   "reuse": null,
   "intro": [
    {
     "h": "同意同建議",
     "p": "<b>I agree</b> 後面可以加 <b>with</b> + 人。<br><b>Let's</b> + 動詞原形，提議一齊做。",
     "ex": [
      [
       "I agree with you.",
       "我同意你。"
      ],
      [
       "Let's discuss the plan.",
       "我哋討論個計劃。"
      ],
      [
       "She suggests a new idea.",
       "佢提出一個新主意。"
      ]
     ]
    },
    {
     "h": "唔同意",
     "p": "<b>I don't agree</b> 或者 <b>I disagree</b>。語氣可以溫和。",
     "ex": [
      [
       "I don't agree with that idea.",
       "我唔同意嗰個主意。"
      ]
     ]
    }
   ],
