   "id": "g17",
   "no": 17,
   "week": 10,
   "emoji": "⏰",
   "title": "時間介詞 at / on / in",
   "en": "prepositions of time",
   "reuse": null,
   "intro": [
    {
     "h": "幾點、星期、月份",
     "p": "<b>at</b> + 幾點；<b>on</b> + 星期或者日子；<b>in</b> + 月份、年份、早上／下午／晚上。",
     "ex": [
      [
       "The class starts at nine.",
       "堂九點開始。"
      ],
      [
       "We have PE on Monday.",
       "我哋星期一有體育。"
      ],
      [
       "I was born in May.",
       "我五月出世。"
      ]
     ]
    },
    {
     "h": "⚠️ 常犯",
     "p": "✅ at night　❌ in night<br>✅ in the morning　❌ at the morning",
     "ex": [
      [
       "I do homework in the evening.",
       "我晚上做功課。"
      ]
     ]
    }
   ],
