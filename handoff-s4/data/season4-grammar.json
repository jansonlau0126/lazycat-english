   "emoji": "🎈",
   "title": "Would you like …?",
   "en": "Would you like",
   "reuse": null,
   "intro": [
    {
     "h": "邀請同款待",
     "p": "<b>Would you like</b> + 名詞，或者 <b>Would you like to</b> + 動詞，用來邀請，語氣客氣。",
     "ex": [
      [
       "Would you like some tea?",
       "你想唔想飲茶？"
      ],
      [
       "Would you like to come?",
       "你想唔想來？"
      ]
     ]
    },
    {
     "h": "點答",
     "p": "想：<b>Yes, please.</b>　唔使：<b>No, thank you.</b>",
     "ex": [
      [
       "Yes, please. I would like to come.",
       "好呀，我想來。"
      ]
     ]
    }
   ],
   "exercises": [
    {
     "t": "mc",
     "q": "Would you like ___ to the party?",
     "zh": "你想唔想來派對？",
     "o": [
      "to come",
      "come",
      "coming",
      "came"
     ],
     "a": 0,
     "why": "Would you like to + 原形。"
    },
    {
     "t": "mc",
     "q": "Would you like ___ tea?",
     "zh": "你想唔想飲茶？",
     "o": [
      "some",
      "any",
      "a",
      "to"
     ],
     "a": 0,
     "why": "名詞用 Would you like some tea?"
    },
    {
     "t": "mc",
     "q": "No, ___ .",
     "zh": "唔使喇，多謝。",
     "o": [
      "thank you",
      "please",
      "I like",
      "thanks you"
     ],
     "a": 0,
     "why": "婉拒可以講 No, thank you。"
    },
