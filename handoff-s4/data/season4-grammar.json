  {
   "id": "g21",
   "no": 21,
   "week": 6,
   "emoji": "😺",
   "title": "too / very / enough",
   "en": "too, very, enough",
   "reuse": null,
   "intro": [
    {
     "h": "程度",
     "p": "<b>very</b> 只係程度高。<b>too</b> 係過分，通常有負面意思。<br><b>enough</b> 放喺形容詞後面。",
     "ex": [
      [
       "She is very kind.",
       "佢非常善良。"
      ],
      [
       "The music is too noisy.",
       "音樂太嘈。"
      ],
      [
       "He is patient enough.",
       "佢夠有耐心。"
      ]
     ]
    },
    {
     "h": "enough + 名詞",
     "p": "enough 放喺名詞前面：enough time、enough friends。",
     "ex": [
      [
       "We have enough food.",
       "我哋有足夠食物。"
      ]
     ]
    }
   ],
   "exercises": [
    {
     "t": "mc",
     "q": "The room is ___ noisy.",
     "zh": "間房太嘈，受唔住。",
     "o": [
