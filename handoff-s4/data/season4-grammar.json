  {
   "id": "g20",
   "no": 20,
   "week": 4,
   "emoji": "🎁",
   "title": "物主 's",
   "en": "possessive 's",
   "reuse": null,
   "intro": [
    {
     "h": "邊個嘅",
     "p": "單數名詞加 <b>'s</b>：Mum's gift、the cat's bow。<br>以 s 結尾嘅複數只加省略號：the students' party。",
     "ex": [
      [
       "This is Mum's gift.",
       "呢個係媽媽嘅禮物。"
      ],
      [
       "The bow is on Dad's box.",
       "蝴蝶結喺爸爸個盒上面。"
      ]
     ]
    },
    {
     "h": "唔好同 is 混淆",
     "p": "<b>Mum's</b> 可以係 Mum is 嘅縮寫，亦可以係「媽媽嘅」。<br>後面係名詞，多數係物主：Mum's gift。",
     "ex": [
      [
       "It is my friend's mooncake.",
       "呢個係我朋友嘅月餅。"
      ]
     ]
    }
   ],
   "exercises": [
    {
     "t": "mc",
     "q": "This is ___ gift.",
     "zh": "呢個係媽媽嘅禮物。",
