  {
   "id": "g23",
   "no": 23,
   "week": 10,
   "emoji": "🙏",
   "title": "客氣請求",
   "en": "polite requests",
   "reuse": null,
   "intro": [
    {
     "h": "請人幫忙",
     "p": "<b>Could you</b> + 原形，比 Can you 更客氣。<br>加 please 更柔和。",
     "ex": [
      [
       "Could you help me, please?",
       "唔該你幫我手，好嗎？"
      ],
      [
       "Could you say that again?",
       "唔該你再講一次？"
      ]
     ]
    },
    {
     "h": "回應",
     "p": "得：<b>Of course.</b> / <b>Sure.</b><br>唔得都可以客氣：<b>I'm sorry, I can't.</b>",
     "ex": [
      [
       "Of course. I can wait.",
       "當然可以，我可以等。"
      ]
     ]
    }
   ],
