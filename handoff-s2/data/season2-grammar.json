    {
      "id": "g10",
      "no": 4,
      "week": 8,
      "emoji": "🚫",
      "title": "祈使句同 don't",
      "en": "Imperatives and don't",
      "reuse": null,
      "intro": [
        {
          "h": "叫人做嘢",
          "p": "祈使句用<b>動詞原形</b>開頭，主語 you 通常唔寫出嚟：Open the door. Wait here. Take this medicine.<br>加 please 會禮貌啲，放句首或句末都得。",
          "ex": [
            [
              "Take this medicine.",
              "食呢啲藥。"
            ],
            [
              "Please wait outside.",
              "請喺出面等。"
            ]
          ]
        },
        {
          "h": "叫人唔好做",
          "p": "<b>Don't</b> + 動詞原形：Don't run. Don't worry. Don't touch.<br>告示、家長同老師好常用。",
          "ex": [
            [
              "Don't run in the hospital.",
              "醫院唔好跑。"
            ],
            [
              "Don't worry.",
              "唔好擔心。"
            ]
          ]
        }
      ],
      "exercises": [
