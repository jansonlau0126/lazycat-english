   "id": "g10",
   "no": 10,
   "week": 8,
   "emoji": "🏥",
   "title": "祈使句",
   "en": "imperatives",
   "reuse": null,
   "intro": [
    {
     "h": "叫人做嘢",
     "p": "祈使句用動詞原形開頭，主語 you 通常唔寫出嚟。<br>客氣可以加 <b>Please</b>。",
     "ex": [
      [
       "Rest today.",
       "今日休息。"
      ],
      [
       "Please wait here.",
       "請喺度等。"
      ]
     ]
    },
    {
     "h": "叫人唔好做",
     "p": "否定用 <b>Don't</b> + 動詞原形。",
     "ex": [
      [
       "Don't run.",
       "唔好跑。"
      ],
      [
       "Please don't shout.",
       "請唔好大聲叫。"
      ]
     ]
    }
   ],
   "exercises": [
    {
     "t": "mc",
     "q": "___ the door, please.",
     "zh": "請開門。",
     "o": [
      "Open",
