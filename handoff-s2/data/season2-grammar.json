  {
   "id": "g11",
   "no": 11,
   "week": 10,
   "emoji": "🎸",
   "title": "like + -ing",
   "en": "like + -ing",
   "reuse": null,
   "intro": [
    {
     "h": "鍾意做某件事",
     "p": "講興趣，<b>like / love / enjoy</b> 後面可以用 <b>動詞 -ing</b>。",
     "ex": [
      [
       "I like swimming.",
       "我鍾意游水。"
      ],
      [
       "She loves reading.",
       "佢好鍾意睇書。"
      ],
      [
       "We enjoy cooking.",
       "我哋鍾意煮飯。"
      ]
     ]
    },
    {
     "h": "⚠️ 同 like + 名詞",
     "p": "like 後面亦可以係名詞：I like music。<br>如果係「做嗰件事」，就用 -ing：I like singing.",
     "ex": [
      [
       "He likes playing football.",
       "佢鍾意踢波。"
      ]
     ]
    }
   ],
   "exercises": [
    {
     "t": "mc",
     "q": "I like ___.",
     "zh": "我鍾意唱歌。",
     "o": [
      "singing",
      "sing",
      "to singing",
      "sings"
     ],
     "a": 0,
     "why": "like 後面用 -ing 表示鍾意做嗰件事。"
    },
    {
     "t": "mc",
     "q": "She ___ dancing.",
     "zh": "佢鍾意跳舞。",
