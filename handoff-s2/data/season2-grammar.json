  "season": 2,
  "lessons": [
    {
      "id": "g07",
      "no": 1,
      "week": 2,
      "emoji": "💪",
      "title": "can / can't（能力同請求）",
      "en": "can / can't for ability and requests",
      "reuse": null,
      "intro": [
        {
          "h": "can 點用？",
          "p": "<b>can + 動詞原形</b> = 有能力、被允許，或者提出請求。<br><b>can't</b> = cannot 縮寫，表示唔能夠／唔准。<br>記住：can 冇第三人稱 -s（正確：he can；錯：he cans）。",
          "ex": [
            [
              "I can swim.",
              "我識游水。"
            ],
            [
              "She can't drive.",
              "佢唔識揸車。"
            ],
            [
              "Can you help me?",
              "可唔可以幫我？"
            ]
          ]
        },
        {
          "h": "問句同答法",
          "p": "問：<b>Can you…?</b>（請求／能力）／<b>Can I…?</b>（請求准許）<br>答：<b>Yes, I can.</b>／<b>No, I can't.</b><br>請求時加 please 會禮貌啲。",
          "ex": [
            [
              "Can I use your phone?",
              "我可唔可以用你電話？"
            ],
            [
              "Yes, you can.",
              "得，可以。"
            ],
            [
              "Can you wait, please?",
              "可唔可以等一陣？"
            ]
          ]
        }
      ],
      "exercises": [
        {
          "t": "mc",
          "q": "She ___ ride a bike.",
          "o": [
            "can",
            "cans",
            "can to"
          ],
          "a": 0
        },
        {
          "t": "mc",
          "q": "___ you open the door?",
          "o": [
            "Can",
            "Do",
            "Are"
          ],
          "a": 0
        },
        {
          "t": "fill",
          "q": "I ___ find my ticket. (cannot 縮寫)",
          "a": [
            "can't",
            "cannot"
          ]
        },
        {
          "t": "fill",
          "q": "Can you ___ me? (help)",
          "a": [
            "help"
          ]
        },
        {
          "t": "tiles",
          "q": "排正確句子",
          "a": "Can you wait please?",
          "extra": [
            "waits",
            "waiting",
            "to"
          ]
        }
      ]
    },
    {
      "id": "g08",
      "no": 2,
      "week": 4,
      "emoji": "📍",
      "title": "There is / There are + 地方介詞",
      "en": "There is / There are + place prepositions",
      "reuse": null,
      "intro": [
        {
          "h": "There is / There are",
          "p": "講「某處有某樣嘢」用 There，唔好用 Have 開頭（錯：Have a park near my home）。<br><b>There is</b> + 單數／不可數<br><b>There are</b> + 複數<br>口語常見 There's。",
          "ex": [
            [
              "There is a park near my home.",
              "我屋企附近有個公園。"
            ],
            [
              "There are two banks on this street.",
              "呢條街有兩間銀行。"
            ]
          ]
        },
        {
          "h": "地方介詞",
          "p": "<b>near</b> 附近 · <b>opposite</b> 對面 · <b>between A and B</b> 之間<br><b>behind</b> 後面 · <b>inside</b> 入面 · <b>outside</b> 出面<br>描述香港街道位置好常用呢幾個。",
          "ex": [
            [
              "The library is opposite the hospital.",
              "圖書館喺醫院對面。"
            ],
            [
              "Wait inside the station.",
              "喺車站入面等。"
            ]
          ]
        }
      ],
      "exercises": [
        {
          "t": "mc",
          "q": "There ___ a station near here.",
          "o": [
            "is",
            "are",
            "am"
          ],
          "a": 0
        },
        {
          "t": "mc",
          "q": "There ___ three exits.",
          "o": [
            "is",
            "are",
            "be"
          ],
          "a": 1
        },
        {
          "t": "fill",
          "q": "The shop is ___ the bank and the park. (between)",
          "a": [
            "between"
          ]
        },
        {
          "t": "fill",
          "q": "The car is ___ the bus. (behind)",
          "a": [
            "behind"
          ]
        },
        {
          "t": "tiles",
          "q": "排正確句子",
          "a": "There is a park near the station.",
          "extra": [
            "are",
