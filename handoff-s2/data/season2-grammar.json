    {
      "id": "g11",
      "no": 5,
      "week": 10,
      "emoji": "❤️",
      "title": "like + 名詞／like + -ing",
      "en": "like + noun / like + -ing",
      "reuse": null,
      "intro": [
        {
          "h": "講鍾意咩",
          "p": "<b>like + 名詞</b>：I like music. I like football.<br><b>like + 動詞-ing</b>：I like swimming. I like reading.<br>兩種都用嚟講興趣；like to + 原形亦得，但初學先掌握名詞同 -ing。",
          "ex": [
            [
              "I like singing.",
              "我鍾意唱歌。"
            ],
            [
              "She likes this film.",
              "佢鍾意呢套戲。"
            ],
            [
              "Do you like cooking?",
              "你鍾意煮食嗎？"
            ]
          ]
        },
        {
          "h": "否定同問句",
          "p": "I <b>don't like</b>… ／ He <b>doesn't like</b>…（第三人稱用 doesn't）<br>問：<b>Do you like…?</b> Yes, I do.／No, I don't.",
          "ex": [
            [
              "I don't like long queues.",
              "我唔鍾意排長龍。"
            ],
            [
              "Does he like tennis?",
              "佢鍾意網球嗎？"
            ]
          ]
        }
      ],
      "exercises": [
        {
          "t": "mc",
          "q": "I like ___.",
